<!-- 昼夜天空背景(固定底层) -->
<view class="sky-bg" style="{{skyStyle}}">
  <view class="stars" style="{{starsStyle}}">
    <view class="star" wx:for="{{stars}}" wx:key="idx" style="{{item.style}}"></view>
  </view>
  <view class="cloud c1" style="{{cloudsStyle}}"></view>
  <view class="cloud c2" style="{{cloudsStyle}}"></view>

  <view class="particles {{seasonClass}}">
    <block wx:if="{{seasonClass === 'p-summer'}}">
      <view class="pt" wx:for="{{rainParticles}}" wx:key="idx" style="{{item.style}}"></view>
    </block>
    <block wx:else>
      <view class="pt" wx:for="{{particles}}" wx:key="idx" style="{{item.style}}"></view>
    </block>
  </view>

  <view class="sun" style="{{sunStyle}}"></view>
  <view class="moon {{moonClass}}" style="{{moonStyle}}"></view>
  <view class="castle"></view>
  <view class="flag"></view>
  <view class="river">
    <view class="river-glint" style="{{riverGlintStyle}}"></view>
    <view class="river-wave w1"></view>
    <view class="river-wave w2"></view>
  </view>
</view>

<!-- 内容层(页面原生滚动) -->
<view class="page-wrap">
  <view class="page">
    <view class="header" style="padding-top: {{statusBarHeight + 8}}px">
      <view class="title">血月日历</view>
      <view class="subtitle">王国：两位君主 · 季节与血月计算</view>
    </view>

    <view class="card form-card">
      <view class="form-item">
        <view class="label">游戏模式</view>
        <picker mode="selector" range="{{modeNames}}" value="{{modeIndex}}" bindchange="onModeChange">
          <view class="picker-value">{{modes[modeIndex].name}} <text class="arrow">▾</text></view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{needIsland}}">
        <view class="label">所在岛屿</view>
        <picker mode="selector" range="{{islandNames}}" value="{{islandIndex}}" bindchange="onIslandChange">
          <view class="picker-value">{{islands[islandIndex].name}} <text class="arrow">▾</text></view>
        </picker>
        <view class="tip">商路包含两个永恒岛, 请先选择所在岛</view>
      </view>

      <view class="form-item">
        <view class="label">当前天数 (1游戏日 = 4分钟, 每4分钟自动+1)</view>
        <view class="stepper-row">
          <view class="step-btn" bindtap="onStepDown">−1</view>
          <input class="day-input" type="number" value="{{dayInput}}"
                 bindinput="onDayInput" placeholder="输入天数, 如 14" />
          <view class="step-btn" bindtap="onStepUp">+1</view>
        </view>
      </view>
    </view>

    <view class="error" wx:if="{{error}}">{{error}}</view>

    <block wx:if="{{result}}">
      <view class="extrapolate-tip" wx:if="{{result.note}}">{{result.note}}</view>

      <view class="card today-card {{result.todayType}}">
        <view class="today-label">第 {{result.day}} 天 · 今天是</view>
        <view class="today-type">{{result.todayTypeName}}</view>
        <view class="today-hint">{{result.todayHint}}</view>
      </view>

      <view class="card clock-card">
        <view class="clock-top">
          <view class="clock-phase {{isBloodNight ? 'blood' : ''}}">{{isBloodNight ? '血月之夜' : dayPhaseName}}</view>
          <view class="clock-remaining">距明天 {{dayRemaining}}</view>
        </view>
        <view class="day-progress"
            bindtouchstart="onProgressTouch" bindtouchmove="onProgressTouch" bindtouchend="onProgressEnd">
        <view class="day-progress-bar" style="{{dayProgressStyle}}"></view>
        <view class="day-progress-knob" style="{{dayKnobStyle}}"></view>
      </view>

        <view class="clock-note">与游戏内昼夜同步 · 1游戏日 = 4现实分钟</view>
      </view>
      <!-- 血月 + 平安日 合并卡 -->
      <view class="card duo-card">
        <view class="duo-half">
          <view class="card-title blood-title">距下次血月</view>
          <view class="count-row" wx:if="{{result.isBloodMoonToday}}">
            <text class="highlight danger">就是今天!</text>
          </view>
          <view class="count-row" wx:else>
            <text class="big-num">{{result.daysUntilBloodMoon}}</text>
            <text class="unit">天后</text>
          </view>
          <view class="sub-line">血月日: 第 {{result.nextBloodMoonDay}} 天</view>
        </view>

        <view class="duo-divider"></view>

        <view class="duo-half">
          <view class="card-title safe-title">下次平安日</view>
          <block wx:if="{{result.nextPeaceDay}}">
            <view class="count-row" wx:if="{{result.isPeaceDayToday}}">
              <text class="highlight safe">就是今天!</text>
            </view>
            <view class="count-row" wx:else>
              <text class="big-num">{{result.daysUntilPeaceDay}}</text>
              <text class="unit">天后</text>
            </view>
            <view class="sub-line">平安日: 第 {{result.nextPeaceDay}} 天</view>
          </block>
          <view wx:else class="sub-line">{{result.peaceNote || '暂无平安日数据'}}</view>
        </view>
      </view>

      <view class="card target-card" wx:if="{{target}}">
        <view class="card-title target-title">迁岛窗口 · {{target.title}}</view>
        <view class="count-row" wx:if="{{target.isTonight}}">
          <text class="highlight gold">就是今晚! 血月结束后立刻出发</text>
        </view>
        <block wx:else>
          <view class="count-row">
            <text class="big-num gold-num">{{target.daysUntil}}</text>
            <text class="unit">个游戏日后</text>
          </view>
          <view class="realtime-row">
            <text class="rt-label">{{target.endOfDay ? '距血月结束' : '实时倒计时'}}</text>
            <text class="rt-time">{{countdown}}</text>
          </view>
        </block>
        <view class="sub-line">
          目标: 第 {{target.day}} 天
          <text wx:if="{{target.year}}"> · 第 {{target.year}} 年 冬季</text>
          <text wx:elif="{{target.cycleDay}}"> · 周期第 {{target.cycleDay}} 天</text>
          <text wx:if="{{target.islandName}}"> · {{target.islandName}}</text>
        </view>
        <view class="strategy-tip">攻略: 该血月结束的当晚立即前往新岛 → 抵达首日为完整平安日 → 春季来临即可耕种赚钱, 避免刚上岛就遭遇血月+寒冬无田可耕。</view>
        <view class="mini-warn" wx:if="{{target.extrapolated}}">目标日在实测日历(第639天)之外, 按第10年节奏外推</view>
      </view>

      


      <view class="card">
        <view class="card-title season-title">当前季节</view>
        <view class="season-line">
          <text class="season-name">{{result.seasonName}}</text>
          <text class="season-detail" wx:if="{{result.isEternal}}">周期第 {{result.cycleDay}}/{{result.cycleDays}} 天</text>
          <text class="season-detail" wx:elif="{{result.year}}">第 {{result.year}} 年 · 第 {{result.dayOfSeason}}/{{result.seasonLength}} 天</text>
          <text class="season-detail" wx:else>周期第 {{result.cycleDay}}/{{result.cycleDays}} 天 · 季内第 {{result.dayOfSeason}}/{{result.seasonLength}} 天</text>
        </view>
        <view class="sub-line" wx:if="{{result.daysToNextSeason !== null}}">距下次换季还有 {{result.daysToNextSeason}} 天</view>
      </view>

      

      <view class="card">
        <view class="card-title cal-title">未来 7 天速览</view>
        <view class="card-subtitle">之后7个游戏日每天的类型, 便于提前规划</view>
        <view class="upcoming-row" wx:if="{{upcoming.length}}">
          <view class="up-item {{item.type}}" wx:for="{{upcoming}}" wx:key="day">
            <view class="up-day">D{{item.day}}</view>
            <view class="up-tag">{{item.short}}</view>
          </view>
        </view>
        <view class="sub-line" wx:else>暂无数据</view>
      </view>
    </block>

    <view class="footer">数据来源: 游戏代码 · 仅供参考, 以游戏内为准</view>
    <view class="footer">联系我：1696853278@qq.com</view>
  </view>
</view>
