/* ============ 昼夜天空背景 ============ */
.sky-bg {
  position: fixed; top: 0; left: 0;
  width: 100vw; height: 100vh;
  overflow: hidden; z-index: 0;
}
.stars { position: absolute; top: 0; left: 0; right: 0; bottom: 0; transition: opacity 1s; }
.star {
  position: absolute; background: #fff; border-radius: 50%;
  animation: twinkle 2.4s infinite alternate ease-in-out;
}
@keyframes twinkle { from { opacity: .25; } to { opacity: 1; } }

.sun {
  position: absolute; width: 96rpx; height: 96rpx; border-radius: 50%;
  margin-left: -48rpx; margin-top: -48rpx;
  background: radial-gradient(circle at 35% 35%, #fff7d0, #ffd257 55%, #ff9d3c);
  box-shadow: 0 0 60rpx 20rpx rgba(255, 210, 120, .55);
  transition: left .26s linear, top .26s linear, opacity .4s linear;
}
.moon {
  position: absolute; width: 80rpx; height: 80rpx; border-radius: 50%;
  margin-left: -40rpx; margin-top: -40rpx;
  background: radial-gradient(circle at 38% 34%, #f5f5ff, #cfd2ea 60%, #9aa0c8);
  box-shadow: 0 0 50rpx 14rpx rgba(200, 210, 255, .4);
  transition: left .26s linear, top .26s linear, opacity .4s linear, background .8s;
}
/* 平安日蓝月 */
.moon.peace {
  background: radial-gradient(circle at 38% 34%, #d8f2ff, #6bb6ff 55%, #2456a8);
  box-shadow: 0 0 60rpx 22rpx rgba(100, 180, 255, .5);
}
/* 血月红月 */
.moon.blood {
  background: radial-gradient(circle at 38% 34%, #ffb0a0, #d84a52 55%, #8c1830);
  box-shadow: 0 0 60rpx 24rpx rgba(230, 60, 70, .45);
}
.cloud { position: absolute; border-radius: 50rpx; background: rgba(255,255,255,.85); filter: blur(18px); }
.c1 { width: 260rpx; height: 60rpx; top: 12%; left: -30%; animation: drift 70s linear infinite; }
.c2 { width: 200rpx; height: 46rpx; top: 22%; left: -30%; animation: drift 95s linear infinite; animation-delay: -40s; }
@keyframes drift { to { transform: translateX(130vw); } }

/* ---- 季节粒子 ---- */
.particles { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.pt { position: absolute; top: -30rpx; }
/* 春: 粉色花瓣, 摇摆飘落 */
.p-spring .pt {
  width: 14rpx; height: 14rpx; opacity: .9;
  background: #ffb7c9;
  border-radius: 50% 0 50% 50%;
  animation-name: fallSway; animation-timing-function: linear; animation-iteration-count: infinite;
}
/* 秋: 橙黄落叶, 旋转飘落 */
.p-autumn .pt {
  width: 16rpx; height: 16rpx; opacity: .95;
  background: linear-gradient(135deg, #ffb457, #e07030);
  border-radius: 50% 0 50% 50%;
  animation-name: fallSway; animation-timing-function: linear; animation-iteration-count: infinite;
}
/* 冬: 白雪, 缓慢摆动 */
.p-winter .pt {
  width: 10rpx; height: 10rpx; opacity: .9;
  background: #fff; border-radius: 50%;
  animation-name: fallSnow; animation-timing-function: linear; animation-iteration-count: infinite;
}
/* 夏: 稀疏雨丝, 快速直落 */
.p-summer .pt {
  width: 3rpx; height: 26rpx; opacity: .65;
  background: rgba(205, 228, 255, .8); border-radius: 3rpx;
  animation-name: fallRain; animation-timing-function: linear; animation-iteration-count: infinite;
}
@keyframes fallSway {
  0%   { transform: translate(0, -4vh) rotate(0deg); }
  25%  { transform: translate(28rpx, 24vh) rotate(95deg); }
  50%  { transform: translate(-16rpx, 50vh) rotate(200deg); }
  75%  { transform: translate(28rpx, 76vh) rotate(290deg); }
  100% { transform: translate(0, 104vh) rotate(380deg); }
}
@keyframes fallSnow {
  0%   { transform: translate(0, -4vh); }
  30%  { transform: translate(20rpx, 30vh); }
  60%  { transform: translate(-20rpx, 66vh); }
  100% { transform: translate(0, 104vh); }
}
@keyframes fallRain {
  0%   { transform: translateY(-6vh); }
  100% { transform: translateY(106vh); }
}

/* 城堡剪影 + 红旗（对称三塔：中央高塔带旗，两侧垛口塔楼，城墙铺满全宽） */
.castle {
  position: absolute; left: 0; right: 0; bottom: 0; height: 700rpx;
  background: #0a0a18;
  clip-path: polygon(
    0 100%, 0 45%,
    6% 45%, 6% 20%,
    6% 12%, 9.5% 12%, 9.5% 20%, 11.5% 20%, 11.5% 12%, 15% 12%, 15% 20%,
    17% 20%, 17% 12%, 20.5% 12%, 20.5% 20%, 22.5% 20%, 22.5% 12%, 26% 12%,
    26% 45%,
    42% 45%, 42% 8%,
    42% 0, 45.3% 0, 45.3% 8%, 47.3% 8%, 47.3% 0, 50.7% 0, 50.7% 8%,
    52.7% 8%, 52.7% 0, 56% 0, 56% 8%,
    58% 8%, 58% 45%,
    74% 45%, 74% 24%,
    74% 16%, 77.5% 16%, 77.5% 24%, 79.5% 24%, 79.5% 16%, 83% 16%, 83% 24%,
    85% 24%, 85% 16%, 88.5% 16%, 88.5% 24%, 90.5% 24%, 90.5% 16%, 94% 16%,
    94% 45%,
    100% 45%, 100% 100%
  );
}

.flag {
  position: absolute; left: 49.5%; bottom: 198rpx;
  width: 4rpx; height: 560rpx; background: #0a0a18;
}

.flag::after {
  content: ''; position: absolute; top: 0; left: 4rpx;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 36rpx solid #c22a3e;
}
/* ---- 底部河流 ---- */
.river {
  position: absolute; left: 0; right: 0; bottom: 0; height: 150rpx;
  background: linear-gradient(180deg, rgba(30,60,110,.55), rgba(10,18,40,.94));
  overflow: hidden;
}
.river-glint {
  position: absolute; top: 0; bottom: 0; width: 110rpx;
  margin-left: -55rpx; filter: blur(6px); opacity: 0;
  transition: left .26s linear, opacity .4s;
}
.river-wave {
  position: absolute; left: -100%; width: 300%; height: 16rpx;
  background: repeating-linear-gradient(90deg,
    rgba(255,255,255,.12) 0 60rpx, rgba(255,255,255,0) 60rpx 140rpx);
  border-radius: 8rpx; filter: blur(3px);
  animation: riverFlow 8s linear infinite;
}
.river-wave.w1 { top: 16rpx; }
.river-wave.w2 { top: 44rpx; opacity: .6; animation-duration: 13s; animation-direction: reverse; }
@keyframes riverFlow { to { transform: translateX(140rpx); } }

/* ============ 内容层 ============ */
.page-wrap { position: relative; z-index: 1; }
.page { padding: 24rpx; padding-bottom: 80rpx; }

.header { padding: 16rpx 8rpx 28rpx; }
.title { font-size: 48rpx; font-weight: 700; letter-spacing: 4rpx; text-shadow: 0 2rpx 12rpx rgba(0,0,0,.5); }
.subtitle { font-size: 24rpx; color: rgba(230,230,250,.8); margin-top: 8rpx; }

.card {
  background: rgba(22, 22, 48, 0.40);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255,255,255,.14);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.25);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.form-item { margin-bottom: 28rpx; }
.form-item:last-child { margin-bottom: 0; }
.label { font-size: 24rpx; color: rgba(255, 255, 255); margin-bottom: 12rpx; }
.picker-value {
  background: rgba(255,255,255,.1);
  border-radius: 14rpx; padding: 22rpx 24rpx; font-size: 30rpx;
}
.arrow { color: rgba(255, 255, 255); float: right; }
.tip { font-size: 22rpx; color: rgba(255, 255, 255); margin-top: 10rpx; }

.stepper-row { display: flex; align-items: center; }
.step-btn {
  width: 110rpx; text-align: center;
  background: rgba(255,255,255,.1); border-radius: 14rpx;
  padding: 20rpx 0; font-size: 30rpx; color: #d5d5f5;
}
.day-input {
  flex: 1; margin: 0 16rpx;
  background: rgba(255,255,255,.1); border-radius: 14rpx;
  padding: 20rpx 24rpx; font-size: 32rpx; text-align: center;
}

.error {
  color: #ff7b7b; background: rgba(90,20,35,.7);
  border-radius: 14rpx; padding: 20rpx 24rpx;
  margin-bottom: 24rpx; font-size: 26rpx;
}
.extrapolate-tip {
  color: #ffd27b; background: rgba(70,55,20,.65);
  border-radius: 14rpx; padding: 18rpx 24rpx;
  margin-bottom: 24rpx; font-size: 24rpx;
}

.today-card { text-align: center; padding: 10rpx 28rpx; }
.today-card.blood_moon { background: rgba(140, 25, 42, .72); }
.today-card.peace_day { background: rgba(25, 75, 140, .68); }
.today-card.season_change { background: rgba(85, 40, 150, .68); }
.today-card.normal { background: rgba(35, 35, 70, .62); }
.today-label { font-size: 26rpx; opacity: .85; }
.today-type { font-size: 56rpx; font-weight: 700; margin: 16rpx 0; }
.today-hint { font-size: 24rpx; opacity: .9; }

/* ---- 昼夜时钟卡 ---- */
.clock-top { display: flex; justify-content: space-between; align-items: baseline; }
.clock-phase { font-size: 40rpx; font-weight: 700; color: #ffd27b; }
.clock-phase.blood { color: #ff6b6b; }
.clock-remaining {
  font-size: 34rpx; font-weight: 700; color: #ffd27b;
  font-variant-numeric: tabular-nums; letter-spacing: 1rpx;
}
.day-progress {
  position: relative;
  height: 14rpx; background: rgba(255,255,255,.15);
  border-radius: 8rpx; margin-top: 18rpx;
  padding: 16rpx 0; margin-bottom: -16rpx; /* 扩大触摸热区 */
  box-sizing: content-box;
}
.day-progress::before {
  content: ''; position: absolute; left: 0; right: 0; top: 16rpx; bottom: 16rpx;
  background: rgba(255,255,255,.15); border-radius: 8rpx;
}
.day-progress-bar {
  position: absolute; left: 0; top: 16rpx; bottom: 16rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #ffb457, #ff7b54, #b98aff);
}
.day-progress-knob {
  position: absolute; top: 50%; width: 32rpx; height: 32rpx;
  margin-left: -16rpx; margin-top: -16rpx; border-radius: 50%;
  background: #fff; box-shadow: 0 0 8rpx rgba(0,0,0,.5);
  pointer-events: none;
}

.clock-note { margin-top: 12rpx; font-size: 22rpx; color: rgba(255, 255, 255); }

.card-title { font-size: 28rpx; margin-bottom: 18rpx; font-weight: 600; }
.card-subtitle { font-size: 22rpx; color: rgba(255, 255, 255); margin: -10rpx 0 16rpx; }
.blood-title { color: #ff8a8a; }
.season-title { color: #c9a0ff; }
.safe-title { color: #8ac6ff; }
.cal-title { color: #ffd27b; }
.count-row { display: flex; align-items: baseline; }
.big-num { font-size: 72rpx; font-weight: 700; color: #ff6b6b; }
.unit { margin-left: 12rpx; font-size: 28rpx; color: rgba(255, 255, 255); }
.highlight { font-size: 44rpx; font-weight: 700; }
.danger { color: #ff6b6b; }
.safe { color: #6bb6ff; }
.gold { color: #ffd27b; }
.sub-line { font-size: 24rpx; color: rgba(255, 255, 255); margin-top: 14rpx; }
.live-line { color: #ffffff; }

.season-line { display: flex; align-items: baseline; flex-wrap: wrap; }
.season-name { font-size: 52rpx; font-weight: 700; color: #c9a0ff; margin-right: 20rpx; }
.season-detail { font-size: 28rpx; color: #e0e0f8; }

.target-card { border: 1rpx solid rgba(255, 210, 123, .3); background: rgba(50, 40, 20, .62); }
.target-title { color: #ffd27b; }
.gold-num { font-size: 72rpx; font-weight: 700; color: #ffd27b; }
.realtime-row { display: flex; align-items: baseline; margin-top: 10rpx; }
.rt-label { font-size: 24rpx; color: rgba(255, 255, 255); margin-right: 16rpx; }
.rt-time {
  font-size: 48rpx; font-weight: 700; color: #ffd27b;
  font-variant-numeric: tabular-nums; letter-spacing: 2rpx;
}
.strategy-tip {
  margin-top: 16rpx; font-size: 24rpx; color: #e8dcb8;
  background: rgba(255, 210, 123, .12);
  border-radius: 12rpx; padding: 16rpx 20rpx; line-height: 1.6;
}
.mini-warn { margin-top: 12rpx; font-size: 22rpx; color: #ffd27b; opacity: .85; }

/* ---- 未来7天: 压缩宽度, 7个一排 ---- */
.upcoming-row { display: flex; flex-wrap: nowrap; }
.up-item {
  flex: 1 1 0; min-width: 0;
  background: rgba(255,255,255,.1);
  border-radius: 10rpx; padding: 12rpx 0; text-align: center;
  margin-right: 7rpx;
}
.up-item:last-child { margin-right: 0; }
.up-item.blood_moon { background: rgba(140, 30, 45, .85); }
.up-item.peace_day { background: rgba(30, 77, 139, .85); }
.up-item.season_change { background: rgba(91, 45, 139, .85); }
.up-day { font-size: 20rpx; color: #d5d5f0; }
.up-tag { font-size: 20rpx; margin-top: 4rpx; color: #ffffff; }
.up-item.normal .up-tag { color: rgba(255, 255, 255); }

.footer { text-align: center; font-size: 22rpx; color: rgba(255, 255, 255); margin-top: 16rpx; }

/* ---- 血月+平安日 合并卡 ---- */
.duo-card { display: flex; align-items: stretch; }
.duo-half { flex: 1 1 0; min-width: 0; }
.duo-half .big-num { font-size: 56rpx; }  /* 半宽卡里数字略缩, 防止"15 天后"换行 */
.duo-half .count-row { flex-wrap: wrap; }
.duo-divider {
  width: 1rpx;
  background: rgba(255,255,255,.14);
  margin: 6rpx 22rpx;
  flex-shrink: 0;
}
